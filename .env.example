# ============================================================================
# СПАС — конфигурация окружения. Скопируй в `.env`, не коммить с настоящими ключами.
# ============================================================================

# === Telegram (обязательно для Telegram-бота) ===============================
BOT_TOKEN=replace_me_with_token_from_botfather

# === Max (мессенджер VK; опционально, нужен только для python -m bot.max) ====
# Получи токен у @MasterBot в приложении Max (https://max.ru/MasterBot).
MAX_BOT_TOKEN=
# По умолчанию — официальный URL платформы. Менять не нужно.
MAX_API_BASE=https://platform-api.max.ru

# === Хранилище ===============================================================
# В Fly.io маунте: /data/spas.db. Локально — `spas.db` рядом со скриптом.
DB_PATH=spas.db

# === Логирование =============================================================
LOG_LEVEL=INFO
# json — структурированные логи (Fly/Datadog/Loki); human — читаемый вывод в шелл.
LOG_FORMAT=human
# DSN от Sentry для production crash-monitoring. Пусто — Sentry отключён.
SENTRY_DSN=

# === LLM-интеграции (опционально) ============================================
# GigaChat (Sber) — нужен для /ask и фото-распознавания (vision).
# Получить: https://developers.sber.ru/portal/products/gigachat
GIGACHAT_API_KEY=
# scope: GIGACHAT_API_PERS (для физлица) или GIGACHAT_API_CORP (юрлицо).
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# YandexGPT / SpeechKit — нужен для TTS/STT и ОС-распознавания текста.
# https://yandex.cloud/ru/services/yandexgpt
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# === REST-API (бот/виджет) ===================================================
# Порт для read-only API (`python -m bot.api`).
API_PORT=8090
# CORS allow-origin: для приватных школьных сайтов укажи конкретный домен.
# По умолчанию `*` (publicly readable, но read-only).
API_CORS_ORIGIN=*

# === HTTP-health (внутренний liveness/readiness) =============================
# Используется Fly.io / k8s для проверки живости.
HEALTH_PORT=8080

# === Throttle middleware =====================================================
# Антиспам: rate сообщений на каждые `per` секунд от одного пользователя.
THROTTLE_RATE=5
THROTTLE_PER=1.0

# === МЧС RSS (бекграунд-задача) ==============================================
# Включить пуш-алерты МЧС: 1 — да, 0 — нет (по умолчанию выключено).
MCHS_RSS_ENABLED=0
# Интервал поллинга в секундах.
MCHS_RSS_INTERVAL_SEC=900

# === Webhook mode (опционально, для prod на Fly.io) =========================
# По умолчанию бот работает в polling режиме. Для webhook укажи:
#   WEBHOOK_MODE=1
#   WEBHOOK_URL=https://spas-ai.fly.dev/tg
#   WEBHOOK_SECRET=replace_me_with_random_string
#   WEBHOOK_PORT=8443
WEBHOOK_MODE=0
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PORT=8443

# === Админ ===================================================================
# Telegram-id, который имеет доступ к /admin_export и /audit.
ADMIN_ID=

# === Backups (опционально, для tools/backup_db.py) ===========================
# S3-совместимое хранилище (Selectel, Yandex Object Storage, MinIO).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=spas-backups/
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# 32-байтовый ключ в hex (64 символа) для шифрования AES-GCM.
# Сгенерировать: `python -c "import secrets;print(secrets.token_hex(32))"`
BACKUP_ENCRYPTION_KEY=

# === Метаданные приложения ===================================================
APP_VERSION=0.3.0
